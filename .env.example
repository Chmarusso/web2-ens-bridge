# GitHub OAuth App — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Reown (WalletConnect) — https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Thirdweb (IPFS uploads) — https://thirdweb.com/dashboard/settings/api-keys
THIRDWEB_SECRET_KEY=

# vlayer (powered by TLSNotary) — https://vlayer.xyz
VOUCH_CLIENT_ID=
VOUCH_SECRET_TOKEN=

# Yellow Network — prover-specific config is in app/config/provers.json
# Private key for the server wallet that authenticates with ClearNode to verify payments
YELLOW_SERVER_PRIVATE_KEY=0x...
